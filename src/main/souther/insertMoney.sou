module app.vending.insertmoney

import app.vending.money ( Money, TenYen, FiftyYen, HundredYen, FiveHundredYen, ThousandYen, amountOf )
import app.vending.balance ( Balance, HasCredit, HasNoCredit, addToBalance )

behavior loadBalance : () -> Balance
behavior saveBalance : (balance: HasCredit) -> HasCredit

fake saveBalance
    | (HasCredit(10)) -> HasCredit(10)
    | (HasCredit(50)) -> HasCredit(50)
    | (HasCredit(100)) -> HasCredit(100)
    | (HasCredit(500)) -> HasCredit(500)
    | (HasCredit(1000)) -> HasCredit(1000)

behavior insertMoney : (money: Money) -> HasCredit
    depends on loadBalance, saveBalance

let insertMoney (money, loadBalance, saveBalance) =
    saveBalance(addToBalance(loadBalance(), amountOf(money)))

example insertMoney
    | "10円玉を入れると入金額が10円増える" : (TenYen) with loadBalance = HasNoCredit -> HasCredit(10)
    | "50円玉を入れると入金額が50円増える" : (FiftyYen) with loadBalance = HasNoCredit -> HasCredit(50)
    | "100円玉を入れると入金額が100円増える" : (HundredYen) with loadBalance = HasNoCredit -> HasCredit(100)
    | "500円玉を入れると入金額が500円増える" : (FiveHundredYen) with loadBalance = HasNoCredit -> HasCredit(500)
    | "1000円札を入れると入金額が1000円増える" : (ThousandYen) with loadBalance = HasNoCredit -> HasCredit(1000)

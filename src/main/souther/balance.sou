module app.vending.balance exposing ( Balance, HasNoCredit, HasCredit, addToBalance )

import app.vending.money (Amount)

data Balance = HasCredit | HasNoCredit

data HasNoCredit
data HasCredit = Int
    invariant value > 0

behavior addToBalance : (balance: Balance, amount: Amount) -> HasCredit

let addToBalance (balance, amount) = match balance with
    | HasCredit(credit) -> HasCredit(credit + amount.value)
    | HasNoCredit -> HasCredit(amount.value)

example addToBalance
    | "入金額が0円の時、100円入れると入金額は100円になる" : (HasNoCredit, Amount(100)) -> HasCredit(100)
    | "入金額が10円の時、100円入れると入金額は110円になる" : (HasCredit(1), Amount(100)) -> HasCredit(101)
    | "入金額が100円の時、100円入れると入金額は200円になる" : (HasCredit(100), Amount(100)) -> HasCredit(200)
